<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_tritunggal_logistik" model="ir.module.category">
        <field name="name">Tritunggal Logistik</field>
        <field name="description">Akses modul Tritunggal Logistik</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_tritunggal_marketing" model="res.groups">
        <field name="name">Tritunggal Marketing</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <record id="group_tritunggal_operasional" model="res.groups">
        <field name="name">Tritunggal Operasional</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <record id="group_tritunggal_maintenance" model="res.groups">
        <field name="name">Tritunggal Maintenance</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <record id="group_tritunggal_supir" model="res.groups">
        <field name="name">Tritunggal Supir</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <record id="group_tritunggal_keuangan" model="res.groups">
        <field name="name">Tritunggal Keuangan/Kasir</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <record id="group_tritunggal_outsource" model="res.groups">
        <field name="name">Tritunggal Outsource Vendor</field>
        <field name="category_id" ref="module_category_tritunggal_logistik"/>
    </record>

    <!-- Domain Rules untuk Supir: hanya lihat penugasan mereka sendiri -->
    <record id="ir_rule_penugasan_supir_own" model="ir.rule">
        <field name="name">Penugasan Pengiriman - Supir melihat penugasan sendiri</field>
        <field name="model_id" ref="model_tritunggal_penugasan_pengiriman"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_supir'))]"/>
        <field name="domain_force">[('supir_id.user_id', '=', user.id)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- Domain Rules untuk Marketing: tidak lihat biaya operasional -->
    <record id="ir_rule_pesanan_marketing" model="ir.rule">
        <field name="name">Pesanan - Marketing kelola pesanan mereka</field>
        <field name="model_id" ref="model_tritunggal_pesanan"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_marketing'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="ir_rule_laporan_kerusakan_supir_own" model="ir.rule">
        <field name="name">Laporan Kerusakan - Supir melihat laporan sendiri</field>
        <field name="model_id" ref="model_tritunggal_laporan_kerusakan"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_supir'))]"/>
        <field name="domain_force">[('pelapor_id', '=', user.id)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="ir_rule_laporan_kerusakan_maintenance_all" model="ir.rule">
        <field name="name">Laporan Kerusakan - Maintenance melihat semua</field>
        <field name="model_id" ref="model_tritunggal_laporan_kerusakan"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_maintenance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="ir_rule_riwayat_perawatan_maintenance_all" model="ir.rule">
        <field name="name">Riwayat Perawatan - Maintenance melihat semua</field>
        <field name="model_id" ref="model_tritunggal_riwayat_perawatan"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_maintenance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="ir_rule_riwayat_perawatan_operasional_read" model="ir.rule">
        <field name="name">Riwayat Perawatan - Operasional lihat semua</field>
        <field name="model_id" ref="model_tritunggal_riwayat_perawatan"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_operasional'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- Domain Rules untuk Keuangan: hanya lihat pengiriman selesai -->
    <record id="ir_rule_pengiriman_keuangan" model="ir.rule">
        <field name="name">Pengiriman - Keuangan lihat yang sudah tiba/selesai</field>
        <field name="model_id" ref="model_tritunggal_pengiriman"/>
        <field name="groups" eval="[(4, ref('group_tritunggal_keuangan'))]"/>
        <field name="domain_force">[('status_pengiriman', 'in', ['tiba'])]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>
</odoo>
