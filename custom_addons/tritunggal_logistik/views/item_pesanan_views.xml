<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tritunggal_item_pesanan_tree" model="ir.ui.view">
        <field name="name">tritunggal.item_pesanan.tree</field>
        <field name="model">tritunggal.item_pesanan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id_item"/>
                <field name="pesanan_id"/>
                <field name="jumlah_barang"/>
                <field name="volume_barang"/>
                <field name="berat_barang"/>
                <field name="subtotal_harga"/>
            </tree>
        </field>
    </record>

    <record id="view_tritunggal_item_pesanan_form" model="ir.ui.view">
        <field name="name">tritunggal.item_pesanan.form</field>
        <field name="model">tritunggal.item_pesanan</field>
        <field name="arch" type="xml">
            <form create="false">
                <style>
                    .o_form_title {
                        display: none !important;
                    }
                    .o_form_navbar {
                        display: none !important;
                    }
                    a[data-tooltip*="Back to"] {
                        display: none !important;
                    }
                    span.min-w-0.text-truncate {
                        display: none !important;
                    }
                </style>
                <toolbar/>
                <header>
                    <div class="d-flex justify-content-between">
                        <div/>
                    </div>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="id_item"/>
                            <field name="pesanan_id"/>
                        </group>
                        <group>
                            <field name="jumlah_barang"/>
                            <field name="volume_barang"/>
                            <field name="berat_barang"/>
                            <field name="subtotal_harga"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tritunggal_item_pesanan" model="ir.actions.act_window">
        <field name="name">Item Pesanan</field>
        <field name="res_model">tritunggal.item_pesanan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
