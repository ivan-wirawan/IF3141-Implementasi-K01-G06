<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tritunggal_invoice_tree" model="ir.ui.view">
        <field name="name">tritunggal.invoice.tree</field>
        <field name="model">tritunggal.invoice</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id_invoice"/>
                <field name="partner_id"/>
                <field name="pesanan_id"/>
                <field name="tgl_terbit"/>
                <field name="tgl_jatuh_tempo"/>
                <field name="total_biaya"/>
                <field name="status_pembayaran"/>
            </tree>
        </field>
    </record>

    <record id="view_tritunggal_invoice_form" model="ir.ui.view">
        <field name="name">tritunggal.invoice.form</field>
        <field name="model">tritunggal.invoice</field>
        <field name="arch" type="xml">
            <form create="false">
                <style>
                    .o_form_title {
                        display: none !important;
                    }
                    .o_form_navbar {
                        display: none !important;
                    }
                    a[data-tooltip*="Back to"] {
                        display: none !important;
                    }
                    span.min-w-0.text-truncate {
                        display: none !important;
                    }
                </style>
                <toolbar/>
                <header>
                    <div class="d-flex justify-content-between">
                        <button string="Kembali" class="btn btn-secondary btn-lg" special="cancel"/>
                        <button name="%(action_report_tritunggal_invoice)d" type="action" string="Print PDF" class="btn btn-primary btn-lg"/>
                    </div>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="id_invoice"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="pesanan_id"/>
                        </group>
                        <group>
                            <field name="tgl_terbit"/>
                            <field name="tgl_jatuh_tempo"/>
                            <field name="total_biaya" readonly="1"/>
                            <field name="status_pembayaran"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tritunggal_invoice" model="ir.actions.act_window">
        <field name="name">Invoice</field>
        <field name="res_model">tritunggal.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
