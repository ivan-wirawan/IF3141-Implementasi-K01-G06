<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tritunggal_penugasan_pengiriman_tree" model="ir.ui.view">
        <field name="name">tritunggal.penugasan_pengiriman.tree</field>
        <field name="model">tritunggal.penugasan_pengiriman</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id_penugasan"/>
                <field name="tgl_penugasan"/>
                <field name="pesanan_id"/>
                <field name="nama_supir"/>
                <field name="nama_employee"/>
                <field name="armada_id"/>
                <field name="status_penugasan"/>
                <field name="status_output_mitra"/>
            </tree>
        </field>
    </record>

    <record id="view_tritunggal_penugasan_pengiriman_form" model="ir.ui.view">
        <field name="name">tritunggal.penugasan_pengiriman.form</field>
        <field name="model">tritunggal.penugasan_pengiriman</field>
        <field name="arch" type="xml">
            <form create="false">
                <style>
                    .o_form_title {
                        display: none !important;
                    }
                    .o_form_navbar {
                        display: none !important;
                    }
                    a[data-tooltip*="Back to"] {
                        display: none !important;
                    }
                    span.min-w-0.text-truncate {
                        display: none !important;
                    }
                </style>
                <toolbar/>
                <header>
                    <div class="d-flex justify-content-between">
                        <div/>
                    </div>
                    <button name="action_change_to_assigned" type="object" string="Tetapkan Penugasan" class="btn btn-success btn-lg" invisible="status_penugasan != 'draft'"/>
                    <button name="action_change_to_running" type="object" string="Mulai Perjalanan" class="btn btn-info btn-lg" invisible="status_penugasan not in ('ditugaskan',)"/>
                    <button name="action_change_to_done" type="object" string="Selesaikan" class="btn btn-primary btn-lg" invisible="status_penugasan != 'berjalan'"/>
                    <button name="action_cancel" type="object" string="Batalkan" class="btn btn-danger btn-lg"/>
                    <field name="status_penugasan" widget="statusbar" statusbar_visible="draft,ditugaskan,berjalan,selesai,batal"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="id_penugasan"/>
                            <field name="tgl_penugasan"/>
                            <field name="status_penugasan"/>
                        </group>
                        <group>
                            <field name="pesanan_id"/>
                            <field name="pengiriman_id"/>
                            <field name="armada_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="supir_id"/>
                            <field name="employee_id"/>
                            <field name="mitra_outsourcing_id"/>
                        </group>
                        <group>
                            <field name="nama_supir" readonly="1"/>
                            <field name="nama_employee" readonly="1"/>
                            <field name="plat_nomor" readonly="1"/>
                            <field name="status_output_mitra"/>
                        </group>
                    </group>
                    <group>
                        <field name="alamat_tujuan" readonly="1"/>
                        <field name="catatan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tritunggal_penugasan_pengiriman" model="ir.actions.act_window">
        <field name="name">Penugasan Pengiriman</field>
        <field name="res_model">tritunggal.penugasan_pengiriman</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>