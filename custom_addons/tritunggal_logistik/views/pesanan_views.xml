<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tritunggal_pesanan_tree" model="ir.ui.view">
        <field name="name">tritunggal.pesanan.tree</field>
        <field name="model">tritunggal.pesanan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id_pesanan"/>
                <field name="partner_id"/>
                <field name="tgl_pesanan"/>
                <field name="alamat_asal"/>
                <field name="alamat_tujuan"/>
                <field name="status_pesanan"/>
                <field name="total_biaya"/>
            </tree>
        </field>
    </record>

    <record id="view_tritunggal_pesanan_form" model="ir.ui.view">
        <field name="name">tritunggal.pesanan.form</field>
        <field name="model">tritunggal.pesanan</field>
        <field name="arch" type="xml">
            <form create="false">
                <style>
                    .o_form_title {
                        display: none !important;
                    }
                    .o_form_navbar {
                        display: none !important;
                    }
                    a[data-tooltip*="Back to"] {
                        display: none !important;
                    }
                    span.min-w-0.text-truncate {
                        display: none !important;
                    }
                </style>
                <toolbar/>
                <header>
                    <div class="d-flex justify-content-between">
                        <button string="Kembali" class="btn btn-secondary btn-lg" special="cancel"/>
                        <div/>
                    </div>
                    <button name="action_verify" type="object" string="Verifikasi" class="btn btn-primary btn-lg" invisible="status_pesanan != 'draft'"/>
                    <button name="action_create_penugasan_draft" type="object" string="Buat Penugasan Pengiriman" class="btn btn-success btn-lg" invisible="status_pesanan != 'terverifikasi'"/>
                    <button name="action_complete" type="object" string="Selesaikan" class="btn btn-primary btn-lg" invisible="status_pesanan != 'terverifikasi'"/>
                    <field name="status_pesanan" widget="statusbar" statusbar_visible="draft,terverifikasi,selesai"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="id_pesanan"/>
                            <field name="partner_id"/>
                            <field name="tgl_pesanan"/>
                        </group>
                        <group>
                            <field name="alamat_asal"/>
                            <field name="alamat_tujuan"/>
                            <field name="total_biaya" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="item_ids">
                            <tree editable="bottom">
                                <field name="id_item"/>
                                <field name="jumlah_barang"/>
                                <field name="volume_barang"/>
                                <field name="berat_barang"/>
                                <field name="subtotal_harga"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tritunggal_pesanan" model="ir.actions.act_window">
        <field name="name">Pesanan</field>
        <field name="res_model">tritunggal.pesanan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
